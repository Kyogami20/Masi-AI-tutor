.gradle/
build/
local.properties
*.iml
.idea/
.cxx/
.kotlin/

# Volcados de la JVM cuando un demonio de Gradle se cae. Ruido, no historia.
hs_err_pid*.log
replay_pid*.log

# El modelo NO se versiona: son ~2,6 GB y no es nuestro. Se descarga o se importa desde el
# teléfono (ver ModeloLocal.kt). Un despiste aquí deja el repositorio inservible para siempre,
# porque el objeto se queda en el historial aunque se borre el archivo después.
*.litertlm
*.task
*.tflite
*.bin

# APKs y claves de firma. El APK de la demo se reparte a mano, no se guarda aquí.
*.apk
*.aab
*.jks
*.keystore

# Lo que SÍ se versiona, anotado para que no se cuele en un `.gitignore` futuro:
#   app/schemas/                      esquemas de Room, imprescindibles para las migraciones
#   gradle/wrapper/gradle-wrapper.jar sin él, `./gradlew` no funciona en otra máquina
